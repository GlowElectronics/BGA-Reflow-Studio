<Window x:Class="BGAReflowStudio.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename Profile" Width="400" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Canvas}" Icon="/icon.ico" ShowInTaskbar="False">
  <Border Style="{StaticResource Card}" Margin="16">
    <StackPanel>
      <TextBlock x:Name="HeaderText" Text="Rename" Style="{StaticResource SectionTitle}"/>
      <TextBlock x:Name="PromptText" Text="Enter a new name:" Style="{StaticResource Muted}" Margin="0,3,0,10"/>
      <TextBox x:Name="NameBox" MaxLength="40"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button Content="OK" Style="{StaticResource PrimaryButton}" Width="88" IsDefault="True" Click="Ok_Click"/>
        <Button Content="Cancel" Width="88" IsCancel="True"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
