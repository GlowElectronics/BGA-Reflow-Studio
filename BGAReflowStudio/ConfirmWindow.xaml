<Window x:Class="BGAReflowStudio.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Canvas}" Icon="/icon.ico" ShowInTaskbar="False">
  <Border Style="{StaticResource Card}" Margin="16">
    <StackPanel>
      <TextBlock x:Name="HeaderText" Text="Confirm" Style="{StaticResource SectionTitle}"/>
      <TextBlock x:Name="MessageText" Text="" Style="{StaticResource Muted}" Margin="0,6,0,10" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" Width="130" Margin="0,0,8,0" IsDefault="True" Click="Primary_Click"/>
        <Button x:Name="SecondaryButton" Width="112" Margin="0,0,8,0" Click="Secondary_Click" Visibility="Collapsed"/>
        <Button x:Name="CancelButton" Content="Cancel" Width="90" IsCancel="True"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
