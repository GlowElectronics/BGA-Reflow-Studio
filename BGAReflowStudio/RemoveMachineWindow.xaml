<Window x:Class="BGAReflowStudio.RemoveMachineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remove Machine" Width="400" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Canvas}" Icon="/icon.ico" ShowInTaskbar="False">
  <Border Style="{StaticResource Card}" Margin="16">
    <StackPanel>
      <TextBlock Text="Remove Machine" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="Select a custom machine to remove. The built-in ACHI machines cannot be removed."
                 Style="{StaticResource Muted}" Margin="0,3,0,10" TextWrapping="Wrap"/>
      <ComboBox x:Name="MachineList"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button Content="Remove" Style="{StaticResource PrimaryButton}" Width="100" IsDefault="True" Click="Ok_Click"/>
        <Button Content="Cancel" Width="88" Margin="8,0,0,0" IsCancel="True"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
