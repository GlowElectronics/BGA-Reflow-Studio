<Window x:Class="BGAReflowStudio.SupportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Support" Width="450" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Canvas}" Icon="/icon.ico">
  <Border Style="{StaticResource Card}" Margin="16">
    <StackPanel>
      <StackPanel Orientation="Horizontal">
        <Viewbox Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Center">
          <Canvas Width="24" Height="24">
            <Path Fill="#7B5333" Data="M6,9 L17,9 L16,16.5 C15.7,17.9 14.5,18.8 13,18.8 L10,18.8 C8.5,18.8 7.3,17.9 7,16.5 Z"/>
            <Path Stroke="#7B5333" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Data="M17,10.5 C20,10.5 20,14.5 17,14.5 M9,2.5 C8,3.7 10,4.7 9,6 M13,2.5 C12,3.7 14,4.7 13,6 M5,20.5 L18,20.5"/>
          </Canvas>
        </Viewbox>
        <TextBlock Text="Support Development" Style="{StaticResource SectionTitle}" FontSize="18" VerticalAlignment="Center"/>
      </StackPanel>

      <TextBlock Text="BGA Reflow Studio is free software." Foreground="{StaticResource Ink}" FontWeight="SemiBold" Margin="0,14,0,6"/>
      <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Ink}"
                 Text="If it's useful to you and you'd like to support the creator and future development, you can buy me a coffee on Ko-fi. Every cup helps — thank you!"/>
      <TextBlock Margin="0,8,0,0">
        <Hyperlink NavigateUri="https://ko-fi.com/glowelectronics" RequestNavigate="Link_RequestNavigate">https://ko-fi.com/glowelectronics</Hyperlink>
      </TextBlock>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button Content="Buy me a coffee on Ko-fi" Style="{StaticResource PrimaryButton}" Click="Kofi_Click"/>
        <Button Content="Close" Width="88" IsCancel="True" Click="Close_Click"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
